#!/bin/bash
# 升级落盘后：恢复 state，补齐 venv，重新渲染并启动服务。
set -uo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; . "${SELF_DIR}/_common"
[ -n "${FNDL_REPO_DIR}" ] || fndl_fail "应用文件缺失（deploy/install.sh 不存在）"

BACKUP_DIR="${TRIM_TEMP_UPGRADE_FOLDER:-${TRIM_PKGVAR:-/tmp}}/fnmedia-dl-upgrade-backup"
_restored=""
if [ -f "${BACKUP_DIR}/state.tar.gz" ]; then
  tar -xzf "${BACKUP_DIR}/state.tar.gz" -C "${FNDL_REPO_DIR}" >> "${FNDL_LOG}" 2>&1 \
    || fndl_fail "恢复配置/任务记录失败：${BACKUP_DIR}/state.tar.gz"
  _restored=1
elif [ -n "${TRIM_PKGVAR:-}" ] && [ -f "${TRIM_PKGVAR}/fnmedia-dl-state-backup/state.tar.gz" ]; then
  # 主备份缺失（临时目录被清 / 两阶段路径不一致）→ 持久区第二备份兜底
  tar -xzf "${TRIM_PKGVAR}/fnmedia-dl-state-backup/state.tar.gz" -C "${FNDL_REPO_DIR}" >> "${FNDL_LOG}" 2>&1 \
    || fndl_fail "恢复配置/任务记录失败：持久区备份 ${TRIM_PKGVAR}/fnmedia-dl-state-backup/state.tar.gz"
  echo "[upgrade] $(date '+%F %T') 主备份缺失，已从持久区备份恢复 state" >> "${FNDL_LOG}" 2>&1 || true
  _restored=1
fi
if [ -z "${_restored}" ]; then
  # 0.1.41.2 事故：备份缺失被静默跳过 → state 全丢无人知。必须留痕告警。
  {
    echo "[upgrade] $(date '+%F %T') WARN: 未找到升级前状态备份（state.tar.gz），配置/任务记录未能恢复；若登录信息缺失请重新登录"
  } >> "${FNDL_LOG}" 2>&1 || true
  echo "[fnmedia-dl] 警告：未找到升级前状态备份，配置/任务记录未能恢复（详见 ${FNDL_LOG}）" >&2
fi

cd "${FNDL_REPO_DIR}" || fndl_fail "无法进入应用目录"
# 依赖：venv 缺失或核心包 import 失败时统一引导（离线 wheelhouse 优先、国内镜像兜底）。
need_deps=1
if [ -x ".venv/bin/python" ] && .venv/bin/python -c 'import fastapi,uvicorn,httpx' >/dev/null 2>&1; then
  need_deps=0
fi
# 诊断留痕：定位「脚本找不到」类问题
{
  echo "[upgrade] $(date '+%F %T') PWD=$(pwd) FNDL_REPO_DIR=${FNDL_REPO_DIR}"
  echo "[upgrade] deploy/ listing: $(ls deploy/ 2>&1 | tr '\n' ' ')"
  echo "[upgrade] bootstrap_deps.sh exists: $(test -f deploy/bootstrap_deps.sh && echo YES || echo NO)"
  echo "[upgrade] .venv python: $(test -x .venv/bin/python && echo YES || echo NO)  need_deps=${need_deps}"
} >> "${FNDL_LOG}" 2>&1 || true
if [ "$need_deps" = "1" ]; then
  BOOT_LOG="$(mktemp /tmp/fndl-boot.XXXXXX 2>/dev/null || echo /tmp/fndl-boot.log)"
  bash "${FNDL_REPO_DIR}/deploy/bootstrap_deps.sh" > "${BOOT_LOG}" 2>&1
  BOOT_RC=$?
  echo "[upgrade] bootstrap exit=${BOOT_RC}" >> "${FNDL_LOG}" 2>&1 || true
  cat "${BOOT_LOG}" >> "${FNDL_LOG}" 2>&1 || true
  if [ "${BOOT_RC}" != "0" ]; then
    BOOT_TAIL="$(tail -n 8 "${BOOT_LOG}" 2>/dev/null | tr '\n' ' ' | tail -c 280)"
    rm -f "${BOOT_LOG}" 2>/dev/null || true
    fndl_fail "Python 运行环境准备失败（exit=${BOOT_RC}）：${BOOT_TAIL}"
  fi
  rm -f "${BOOT_LOG}" 2>/dev/null || true
fi
bash deploy/install.sh >> "${FNDL_LOG}" 2>&1 || {
  tail -n 12 "${FNDL_LOG}" >&2 || true
  fndl_fail "升级后服务启动失败，详见 ${FNDL_LOG}"
}
rm -rf "${BACKUP_DIR}"
# 同步共享目录/授权目录清单给应用（默认下载目录等）
fndl_sync_paths
exit 0
