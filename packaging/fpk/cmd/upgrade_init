#!/bin/bash
# 升级前：停服务，备份 state。
# App Center 升级会重建 repo 目录；配置/任务记录都在 state/ 内。
set -uo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; . "${SELF_DIR}/_common"

systemctl stop fnmedia-dl.service >> "${FNDL_LOG}" 2>&1 || true

# 迁卷/换目录自愈：旧 unit 指向其他副本时，后续 install.sh 会渲染新路径。
UNIT_FILE="/etc/systemd/system/fnmedia-dl.service"
if [ -n "${FNDL_REPO_DIR}" ] && [ -f "${UNIT_FILE}" ]; then
  unit_wd="$(sed -n 's/^[[:space:]]*WorkingDirectory=//p' "${UNIT_FILE}" | head -n1)"
  unit_wd_real="$(readlink -f -- "${unit_wd}" 2>/dev/null || true)"
  repo_real="$(readlink -f -- "${FNDL_REPO_DIR}" 2>/dev/null || true)"
  if [ -n "${unit_wd_real}" ] && [ "${unit_wd_real}" != "${repo_real}/app" ]; then
    rm -f "${UNIT_FILE}"
    systemctl daemon-reload >> "${FNDL_LOG}" 2>&1 || true
  fi
fi

[ -n "${FNDL_REPO_DIR}" ] || exit 0
BACKUP_DIR="${TRIM_PKGVAR:-/tmp}/fnmedia-dl-upgrade-backup"
rm -rf "${BACKUP_DIR}"; mkdir -p "${BACKUP_DIR}"
if [ -d "${FNDL_REPO_DIR}/state" ]; then
  tar --ignore-failed-read -czf "${BACKUP_DIR}/state.tar.gz" \
    -C "${FNDL_REPO_DIR}" state >> "${FNDL_LOG}" 2>&1 || true
fi
exit 0
