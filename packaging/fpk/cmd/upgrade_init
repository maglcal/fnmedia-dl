#!/bin/bash
# 升级前：停服务，备份 state。
# App Center 升级会重建 repo 目录；配置/任务记录都在 state/ 内。
set -uo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; . "${SELF_DIR}/_common"

systemctl stop fnmedia-dl.service >> "${FNDL_LOG}" 2>&1 || true

# 迁卷/换目录自愈：旧 unit 指向其他副本时，后续 install.sh 会渲染新路径。
UNIT_FILE="/etc/systemd/system/fnmedia-dl.service"
if [ -n "${FNDL_REPO_DIR}" ] && [ -f "${UNIT_FILE}" ]; then
  unit_wd="$(sed -n 's/^[[:space:]]*WorkingDirectory=//p' "${UNIT_FILE}" | head -n1)"
  unit_wd_real="$(readlink -f -- "${unit_wd}" 2>/dev/null || true)"
  repo_real="$(readlink -f -- "${FNDL_REPO_DIR}" 2>/dev/null || true)"
  if [ -n "${unit_wd_real}" ] && [ "${unit_wd_real}" != "${repo_real}/app" ]; then
    rm -f "${UNIT_FILE}"
    systemctl daemon-reload >> "${FNDL_LOG}" 2>&1 || true
  fi
fi

[ -n "${FNDL_REPO_DIR}" ] || exit 0
BACKUP_DIR="${TRIM_TEMP_UPGRADE_FOLDER:-${TRIM_PKGVAR:-/tmp}}/fnmedia-dl-upgrade-backup"
rm -rf "${BACKUP_DIR}"; mkdir -p "${BACKUP_DIR}"
if [ -d "${FNDL_REPO_DIR}/state" ]; then
  # 备份失败必须中止升级（0.1.41.2 事故：|| true 吞错 → App Center 重建
  # repo 后 state 全丢且无人知晓）。升级尚未替换文件，中止 = 数据完好。
  tar --ignore-failed-read -czf "${BACKUP_DIR}/state.tar.gz" \
    -C "${FNDL_REPO_DIR}" state >> "${FNDL_LOG}" 2>&1 \
    || fndl_fail "升级前备份配置/任务记录失败，已中止升级以保护数据（详见 ${FNDL_LOG}）"
  [ -s "${BACKUP_DIR}/state.tar.gz" ] \
    || fndl_fail "升级前状态备份为空（state.tar.gz），已中止升级以保护数据"
  # 第二份备份落持久区（TRIM_PKGVAR）：防 TRIM_TEMP_UPGRADE_FOLDER 两阶段
  # 路径不一致 / 临时目录被清导致恢复时找不到备份。保留最近两份。
  if [ -n "${TRIM_PKGVAR:-}" ]; then
    _pb="${TRIM_PKGVAR}/fnmedia-dl-state-backup"
    mkdir -p "${_pb}" 2>/dev/null || true
    [ -f "${_pb}/state.tar.gz" ] && mv -f "${_pb}/state.tar.gz" "${_pb}/state.tar.gz.1" 2>/dev/null || true
    cp -f "${BACKUP_DIR}/state.tar.gz" "${_pb}/state.tar.gz" 2>/dev/null || true
  fi
fi
exit 0
