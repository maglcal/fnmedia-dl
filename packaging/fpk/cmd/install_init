#!/bin/bash
# 落盘前硬前置检查。
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; . "${SELF_DIR}/_common"

# —— 免责声明确认（由 wizard/install 收集为环境变量）——
# 未明确同意一律中止安装。兼容向导 checkbox 序列化出的多种取值：
#   ["agree"] / agree / true / 1 / yes / on
agree_raw="${wizard_agree_terms:-}"
agree_ok=0
case "${agree_raw}" in
  *agree*|*true*|1|yes|on) agree_ok=1 ;;
esac
# 去掉空白与括号后的兜底判断
_norm="$(printf '%s' "${agree_raw}" | tr -d '[]"[:space:]' | tr 'A-Z' 'a-z')"
[ "${_norm}" = "agree" ] && agree_ok=1
if [ "${agree_ok}" -ne 1 ]; then
  fndl_fail "请先阅读并勾选同意《免责声明》后再安装。本插件仅供学习交流，本身不内置任何内容源。"
fi

command -v python3 >/dev/null 2>&1 || fndl_fail "需要 python3"

# —— Docker 版迅雷安装方式（向导单选，取值视为不可信输入需校验）——
# deploy = 装完自动部署 cnk3x/xunlei；existing/skip = 不自动部署。
xd_raw="$(printf '%s' "${wizard_xunlei_docker:-}" | tr -d '[]"[:space:]' | tr 'A-Z' 'a-z')"
case "${xd_raw}" in
  ""|deploy|existing|skip) ;;
  *) fndl_fail "「Docker 版迅雷」选项取值无效，请返回上一步重新选择。" ;;
esac

# —— Docker 版存放位置（默认 / 自己设置；路径同样视为不可信输入）——
# mode 取值：default = 用默认位置；custom = 用下方文本框路径（必须绝对路径）。
xd_data_mode="$(printf '%s' "${wizard_xunlei_data_mode:-}" | tr -d '[]"[:space:]' | tr 'A-Z' 'a-z')"
xd_dl_mode="$(printf '%s' "${wizard_xunlei_dl_mode:-}" | tr -d '[]"[:space:]' | tr 'A-Z' 'a-z')"
case "${xd_data_mode}" in ""|default|custom) ;; *) fndl_fail "「配置文件存放位置」选项取值无效，请返回上一步重新选择。" ;; esac
case "${xd_dl_mode}" in ""|default|custom) ;; *) fndl_fail "「下载文件存放位置」选项取值无效，请返回上一步重新选择。" ;; esac
_fndl_check_xd_dir() {
  # $1 = 模式 $2 = 路径 $3 = 中文名
  [ "$1" = "custom" ] || return 0
  [ -n "$2" ] || fndl_fail "已选「自己设置」，请填写$3（NAS 绝对路径，如 /vol1/1000/downloads）"
  case "$2" in
    /*) ;;
    *) fndl_fail "$3必须是绝对路径（以 / 开头）：$2" ;;
  esac
  case "$2" in
    *..*|*$'\n'*|*$'\t'*) fndl_fail "$3不合法：$2" ;;
  esac
}
_fndl_check_xd_dir "${xd_data_mode}" "${wizard_xunlei_data_dir:-}" "配置文件存放位置"
_fndl_check_xd_dir "${xd_dl_mode}" "${wizard_xunlei_dl_dir:-}" "下载文件存放位置"
exit 0
