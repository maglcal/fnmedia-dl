#!/bin/bash
# 文件落盘后：确保依赖并启动服务。
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; . "${SELF_DIR}/_common"
# 第二道保险：未同意免责声明则不完成安装（正常已在 install_init 被拦截）
case "${wizard_agree_terms:-}" in
  *agree*|*true*|1|yes|on) ;;
  *) fndl_fail "未同意《免责声明》，已取消安装。本插件仅供学习交流，本身不内置任何内容源。" ;;
esac
[ -n "${FNDL_REPO_DIR}" ] || fndl_fail "应用文件缺失（deploy/install.sh 不存在）"
cd "${FNDL_REPO_DIR}" || fndl_fail "无法进入应用目录"
# 依赖：venv 缺失或核心包 import 失败时统一引导（离线 wheelhouse 优先、国内镜像兜底）。
need_deps=1
if [ -x ".venv/bin/python" ] && .venv/bin/python -c 'import fastapi,uvicorn,httpx' >/dev/null 2>&1; then
  need_deps=0
fi
if [ "$need_deps" = "1" ]; then
  bash deploy/bootstrap_deps.sh || {
    tail -n 14 "${FNDL_LOG}" >&2 2>/dev/null || true
    fndl_fail "Python 运行环境准备失败（已尝试内置离线包与多个国内镜像），详见 ${FNDL_LOG}"
  }
fi
bash deploy/install.sh >> "${FNDL_LOG}" 2>&1 || { tail -n 8 "${FNDL_LOG}" >&2 || true; fndl_fail "服务启动失败，详见 ${FNDL_LOG}"; }
# 同步共享目录/授权目录清单给应用（默认下载目录等）
fndl_sync_paths
# —— Docker 版迅雷自动部署（向导选了「帮我自动部署」才触发）——
# 后台独立进程执行：镜像拉取可能要几分钟，不能卡住安装流程；
# 进度/结果见管理页「迅雷下载引擎」卡片（state/xunlei-deploy.json）。
xd_pick="$(printf '%s' "${wizard_xunlei_docker:-}" | tr -d '[]"[:space:]' | tr 'A-Z' 'a-z')"
if [ "${xd_pick}" = "deploy" ]; then
  if [ -n "${FNDL_REPO_DIR}" ] && [ -x "${FNDL_REPO_DIR}/.venv/bin/python" ]; then
    # 向导里选了「自己设置」的存放位置则透传给部署脚本（已在 install_init 校验过）
    xd_cmd=( ./.venv/bin/python app/xunlei_docker.py run )
    xd_data_mode="$(printf '%s' "${wizard_xunlei_data_mode:-}" | tr -d '[]"[:space:]' | tr 'A-Z' 'a-z')"
    xd_dl_mode="$(printf '%s' "${wizard_xunlei_dl_mode:-}" | tr -d '[]"[:space:]' | tr 'A-Z' 'a-z')"
    [ "${xd_data_mode}" = "custom" ] && xd_cmd+=( --data-dir "${wizard_xunlei_data_dir}" )
    [ "${xd_dl_mode}" = "custom" ] && xd_cmd+=( --dl-dir "${wizard_xunlei_dl_dir}" )
    ( cd "${FNDL_REPO_DIR}" && nohup "${xd_cmd[@]}" >> "${FNDL_LOG}" 2>&1 & )
    echo "[fnmedia-dl] 已在后台自动部署 Docker 版迅雷（cnk3x/xunlei），进度见管理页「迅雷下载引擎」卡片" >> "${FNDL_LOG}"
  else
    echo "[fnmedia-dl] 未找到应用 Python 环境，跳过 Docker 版迅雷自动部署；可稍后在管理页「迅雷下载引擎」卡片点「一键部署」" >> "${FNDL_LOG}"
  fi
fi
exit 0
